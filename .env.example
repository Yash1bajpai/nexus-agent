# Copy this file to .env and fill in your keys

# --- LLM Providers ---
# At least one key is required. Others are optional.
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# --- OpenRouter Model Override ---
# Defaults to google/gemma-4-26b-a4b-it:free. Free models rotate frequently.
# Find current free models at https://openrouter.ai/api/v1/models
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- Default Provider ---
# Options: local | gemini | anthropic | openai | auto | openrouter | ollama
DEFAULT_PROVIDER=local

# --- Behavior ---
MAX_CONVERSATION_MESSAGES=60
CODE_EXECUTION_TIMEOUT=10

# --- Ollama (optional) ---
# OLLAMA_HOST=http://localhost:11434/v1
# LOCAL_MODEL=qwen2.5-coder:7b
