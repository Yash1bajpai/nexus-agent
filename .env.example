# User config: ~/.nexus-agent/.env. Project .env needs explicit NEXUS_AGENT_ALLOW_PROJECT_ENV=1.

# --- LLM Providers ---
# No key is required for local inference. Cloud providers need their matching key.
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# --- OpenRouter Model Override ---
# Defaults to google/gemma-4-26b-a4b-it:free. Free models rotate frequently.
# Find current free models at https://openrouter.ai/api/v1/models
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# --- Default Provider ---
# Options: local | gemini | anthropic | openai | auto | openrouter | ollama
DEFAULT_PROVIDER=local

# --- Local Model (any HuggingFace GGUF repo) ---
# Defaults to the built-in Liquid model; auto-configured by onboarding.
# NEXUS_AGENT_MODEL_REPO=LiquidAI/LFM2.5-2.6B-GGUF
# NEXUS_AGENT_MODEL_FILENAME=LFM2.5-2.6B-Q4_K_M.gguf

# --- Behavior ---
MAX_CONVERSATION_MESSAGES=60
CODE_EXECUTION_TIMEOUT=10

# --- Ollama (optional) ---
# OLLAMA_HOST=http://localhost:11434/v1
# LOCAL_MODEL=qwen2.5-coder:7b

# Project execution is opt-in for trusted code, NOT sandboxed.
# NEXUS_ALLOW_PROJECT_EXECUTION=1
# Autonomous commits are opt-in; prefer nexus-agent commit for confirmation.
# NEXUS_ALLOW_GIT_COMMIT=1
# Single-slot llama-server context; increasing this uses more RAM.
# NEXUS_CONTEXT_SIZE=4096
